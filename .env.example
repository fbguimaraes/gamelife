# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings > Data API / API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Credenciais de uma conta de teste descartável (ex: e-mail @mailinator.com),
# usadas pelos testes E2E (Playwright, item 4.3, npm run test:e2e). Nunca uma
# conta real — os testes criam e removem atividades nela.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
